{
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.0"
  },
  "description": "FlowLab Studio \u2014 \u6d4f\u89c8\u5668\u7aef\u53ef\u89c6\u5316\u6570\u636e\u5de5\u4f5c\u6d41 IDE\uff08\u7eaf\u9759\u6001\u524d\u7aef\uff09",
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "2.1.8",
    "eslint": "9.15.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "8.15.0",
    "vite": "^6.3.5",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "name": "flowlab-studio",
  "private": true,
  "scripts": {
    "build": "vite build && npm run build:sw",
    "dev": "vite",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "npm run test:unit",
    "test:e2e": "playwright test",
    "test:unit": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "bench": "playwright test --config tests/bench/playwright.bench.config.ts",
    "build:sw": "node scripts/build-sw.mjs"
  },
  "type": "module",
  "version": "0.1.0"
}
